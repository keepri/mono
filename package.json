{
    "name": "clfxc-mono",
    "version": "0.0.1",
    "license": "MIT",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "db:connect": "turbo db:connect",
        "db:studio": "turbo dev --filter=db --output-logs=new-only",
        "db:generate": "turbo db:generate --filter=db",
        "db:push": "turbo db:push --filter=db",
        "db:push-data-loss": "turbo db:push-data-loss --filter=db",
        "build": "turbo build",
        "dev": "turbo dev --parallel --output-logs=new-only",
        "check": "turbo check",
        "clean": "turbo clean && turbo daemon clean && rm -rf node_modules .turbo package-lock.json",
        "lint": "turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,md}\"",
        "foley:dev": "turbo dev --filter=foley --output-logs=new-only",
        "foley:build": "turbo db:generate --filter=db && turbo build --filter=foley",
        "foley:test": "bun run --filter=foley test",
        "foley:test:serial": "bun run foley:test:unit && bun run foley:test:integration && bun run foley:test:e2e",
        "foley:test:unit": "bun run --filter=foley test:unit",
        "foley:test:integration": "bun run --filter=foley test:integration",
        "foley:test:e2e": "bun run --filter=foley test:e2e"
    },
    "devDependencies": {
        "@turbo/gen": "^1.9.7",
        "eslint": "^7.32.0",
        "eslint-config-custom": "*",
        "prettier": "^2.8.8",
        "turbo": "^2.11.2",
        "vitest": "^5.0.1"
    },
    "engines": {
        "node": "^22.0.0"
    },
    "packageManager": "bun@1.4.2"
}
