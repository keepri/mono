{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./nextjs.base.json",
    "compilerOptions": {
        "baseUrl": "src",
        "paths": {
            "@styles/*": [
                "styles/*"
            ],
            "@components/*": [
                "components/*"
            ],
            "@pages/*": [
                "pages/*"
            ],
            "@utils/*": [
                "utils/*"
            ],
            "@images/*": [
                "../public/images/*"
            ],
            "@svg/*": [
                "../public/svg/*"
            ],
            "@env/*": [
                "env/*"
            ]
        },
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false
    },
    "include": [
        "src",
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        ".next"
    ]
}
